{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "garmin-personal-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": false,
  "secrets": { "required": ["GARMIN_PERSONAL_API_KEY", "OWNER_LOGIN_KEY"] },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "31002301", "simple": { "limit": 20, "period": 60 } },
    { "name": "DATA_LIMITER", "namespace_id": "31002302", "simple": { "limit": 60, "period": 60 } }
  ],
  "vars": {
    "GARMIN_REGION": "cn",
    "PUBLIC_ORIGIN": "http://localhost:8787",
    "AUTH_VERSION": "1",
    "ENABLE_STATIC_TOKEN": "false"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": { "invocation_logs": false }
  }
}
